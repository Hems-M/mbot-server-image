# One ROS environment for MBot system services and login shells (D-05, ROS-001).
# Installed to /etc/mbot/ros.env.
# Services read it with EnvironmentFile=; shells read it through /etc/profile.d/90-mbot.sh.
# Plain KEY=VALUE lines only, so systemd can parse it.
ROS_DISTRO=jazzy
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ROS_DOMAIN_ID=0
